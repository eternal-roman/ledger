{
  "name": "@eternal-roman/ledger-mcp",
  "version": "0.18.0",
  "description": "MCP server for the Ledger kernel. Agents call money_compute, entry_validate, ledger_post — they do not do money math in tokens. Fail-closed, audit-hashed, deterministic.",
  "type": "module",
  "bin": {
    "ledger-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "llm-guardrail",
    "ledger",
    "accounting",
    "double-entry",
    "deterministic",
    "fintech"
  ],
  "author": "eternal-roman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternal-roman/ledger.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/eternal-roman/ledger/tree/main/mcp#readme",
  "dependencies": {
    "@eternal-roman/ledger": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
